<Page x:Class="GoogleAdsOptimizer.Views.ReportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Performance Reports"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16"
                                  materialDesign:Elevation="Dp4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                           ToolTip="Generate Report"
                           Click="GenerateReport_Click">
                        <materialDesign:PackIcon Kind="FileDocument"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                           ToolTip="Refresh"
                           Click="Refresh_Click">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileChart" Width="32" Height="32"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Performance Reports" FontSize="24" FontWeight="Bold"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Date Range Selector -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <DatePicker materialDesign:HintAssist.Hint="Start Date"
                          Width="150" Margin="0,0,8,0"
                          SelectedDate="{Binding ReportStartDate, Mode=TwoWay}"/>

                <DatePicker materialDesign:HintAssist.Hint="End Date"
                          Width="150" Margin="0,0,8,0"
                          SelectedDate="{Binding ReportEndDate, Mode=TwoWay}"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                       Content="Generate Performance Report"
                       Click="GenerateReport_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <TabControl Grid.Row="2" materialDesign:Elevation="Dp4">
            <!-- Account Overview Tab -->
            <TabItem Header="Account Overview">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="16">

                        <!-- Account Metrics Cards -->
                        <materialDesign:Card Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Spend" FontSize="14"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"
                                              Text="{Binding AccountMetrics[0].Value}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding AccountMetrics[0].ChangeSymbol}"
                                                  Foreground="{Binding AccountMetrics[0].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                        <TextBlock Text="{Binding AccountMetrics[0].Change}"
                                                  Margin="4,0,0,0"
                                                  Foreground="{Binding AccountMetrics[0].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Total Conversions" FontSize="14"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"
                                              Text="{Binding AccountMetrics[1].Value}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding AccountMetrics[1].ChangeSymbol}"
                                                  Foreground="{Binding AccountMetrics[1].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                        <TextBlock Text="{Binding AccountMetrics[1].Change}"
                                                  Margin="4,0,0,0"
                                                  Foreground="{Binding AccountMetrics[1].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Average ROI" FontSize="14"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"
                                              Text="{Binding AccountMetrics[2].Value}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding AccountMetrics[2].ChangeSymbol}"
                                                  Foreground="{Binding AccountMetrics[2].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                        <TextBlock Text="{Binding AccountMetrics[2].Change}"
                                                  Margin="4,0,0,0"
                                                  Foreground="{Binding AccountMetrics[2].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Active Campaigns" FontSize="14"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"
                                              Text="{Binding AccountMetrics[3].Value}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding AccountMetrics[3].ChangeSymbol}"
                                                  Foreground="{Binding AccountMetrics[3].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                        <TextBlock Text="{Binding AccountMetrics[3].Change}"
                                                  Margin="4,0,0,0"
                                                  Foreground="{Binding AccountMetrics[3].ChangeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Performance Summary -->
                        <materialDesign:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="Account Performance Summary" FontSize="18"
                                          FontWeight="Bold" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0"
                                           Background="{DynamicResource SuccessBrush}"
                                           Padding="12"
                                           Margin="0,0,4,4"
                                           CornerRadius="4">
                                        <TextBlock Text="Strong ROI Growth: +12.5% vs previous period"
                                                  Foreground="White"
                                                  TextWrapping="Wrap"/>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1"
                                           Background="{DynamicResource InfoBrush}"
                                           Padding="12"
                                           Margin="0,0,0,4"
                                           CornerRadius="4">
                                        <TextBlock Text="Conversion Rate Improved: +8.3%"
                                                  Foreground="White"
                                                  TextWrapping="Wrap"/>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0"
                                           Background="{DynamicResource WarningBrush}"
                                           Padding="12"
                                           Margin="0,0,4,0"
                                           CornerRadius="4">
                                        <TextBlock Text="Budget Utilization: 87% (consider increasing spend on top performers)"
                                                  Foreground="White"
                                                  TextWrapping="Wrap"/>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1"
                                           Background="{DynamicResource PrimaryHueMidBrush}"
                                           Padding="12"
                                           CornerRadius="4">
                                        <TextBlock Text="3 Campaigns Need Optimization Attention"
                                                  Foreground="White"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Reports List Tab -->
            <TabItem Header="Reports List">
                <DataGrid ItemsSource="{Binding Reports}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat='yyyy-MM-dd'}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                               ToolTip="Export"
                                               Click="ExportReport_Click"
                                               Tag="{Binding}">
                                            <materialDesign:PackIcon Kind="Download"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                               ToolTip="Delete"
                                               Click="DeleteReport_Click"
                                               Tag="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="2"
              Background="#CC000000"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                           Width="200" Height="4"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Generating report..."
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>