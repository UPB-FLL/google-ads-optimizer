<Window x:Class="GoogleAdsOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Google Ads Optimizer" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16"
                                  materialDesign:Elevation="Dp4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Settings"
                            Click="Settings_Click">
                        <materialDesign:PackIcon Kind="Settings"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Help"
                            Click="Help_Click">
                        <materialDesign:PackIcon Kind="Help"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Google" Width="32" Height="32"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Google Ads Optimizer" FontSize="24" FontWeight="Bold"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Main Content Area with Navigation -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                   BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <!-- Dashboard Button -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Padding="16,12" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <!-- Campaign Analysis Button -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Padding="16,12" Click="CampaignAnalysis_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Margin="0,0,12,0"/>
                            <TextBlock Text="Campaign Analysis"/>
                        </StackPanel>
                    </Button>

                    <!-- AI Ad Generator Button -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Padding="16,12" Click="AdGenerator_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AutoFix" Margin="0,0,12,0"/>
                            <TextBlock Text="AI Ad Generator"/>
                        </StackPanel>
                    </Button>

                    <!-- Performance Reports Button -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                           Padding="16,12" Click="Reports_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileChart" Margin="0,0,12,0"/>
                            <TextBlock Text="Performance Reports"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content Frame -->
            <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"
                  Background="{DynamicResource MaterialDesignPaper}"/>
        </Grid>

        <!-- Status Bar -->
        <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryDark" Padding="8,4"
                                  materialDesign:Elevation="Dp4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="StatusText"
                          Text="Ready | Not connected to Google Ads"/>
                <TextBlock DockPanel.Dock="Right" x:Name="VersionText"
                          Text="v1.0.0" HorizontalAlignment="Right"/>
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>