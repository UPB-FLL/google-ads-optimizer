<Page x:Class="GoogleAdsOptimizer.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Settings"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16"
>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                           ToolTip="Save Settings"
                           Click="SaveSettings_Click">
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                           ToolTip="Clear All Settings"
                           Click="ClearSettings_Click">
                        <materialDesign:PackIcon Kind="DeleteForever"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Settings" Width="32" Height="32"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- Connection Status Card -->
                <materialDesign:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Connection Status" FontSize="16"
                                  FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Google Ads Status -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Google Ads API"
                                          FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="12" Height="12"
                                           Fill="{Binding IsGoogleAdsConfigured, Converter={StaticResource BoolToStatusConverter}}"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IsGoogleAdsConfigured, Converter={StaticResource BoolToStatusConverter}}"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- OpenAI Status -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OpenAI API"
                                          FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="12" Height="12"
                                           Fill="{Binding IsOpenAIConfigured, Converter={StaticResource BoolToStatusConverter}}"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IsOpenAIConfigured, Converter={StaticResource BoolToStatusConverter}}"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Google Ads Configuration -->
                <materialDesign:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Google Ads API Configuration" FontSize="16"
                                  FontWeight="Bold" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Client ID -->
                                <TextBox materialDesign:HintAssist.Hint="OAuth2 Client ID"
                                        x:Name="GoogleAdsClientIdTextBox"
                                        Text="{Binding GoogleAdsClientId, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Client Secret -->
                                <TextBox materialDesign:HintAssist.Hint="OAuth2 Client Secret"
                                        x:Name="GoogleAdsClientSecretTextBox"
                                        Text="{Binding GoogleAdsClientSecret, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Refresh Token -->
                                <TextBox materialDesign:HintAssist.Hint="OAuth2 Refresh Token"
                                        x:Name="GoogleAdsRefreshTokenTextBox"
                                        Text="{Binding GoogleAdsRefreshToken, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Developer Token -->
                                <TextBox materialDesign:HintAssist.Hint="Developer Token"
                                        x:Name="GoogleAdsDeveloperTokenTextBox"
                                        Text="{Binding GoogleAdsDeveloperToken, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Customer ID -->
                                <TextBox materialDesign:HintAssist.Hint="Customer ID (XXX-XXX-XXXX)"
                                        x:Name="GoogleAdsCustomerIdTextBox"
                                        Text="{Binding GoogleAdsCustomerId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Test Connection Button -->
                            <Button Grid.Column="1"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Content="Test Connection"
                                   Click="TestGoogleAdsConnection_Click"
                                   VerticalAlignment="Top"
                                   Margin="16,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- OpenAI Configuration -->
                <materialDesign:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="OpenAI API Configuration" FontSize="16"
                                  FontWeight="Bold" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- API Key -->
                                <TextBox materialDesign:HintAssist.Hint="API Key"
                                        x:Name="OpenAIApiKeyTextBox"
                                        Text="{Binding OpenAIApiKey, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Deployment Name -->
                                <TextBox materialDesign:HintAssist.Hint="Deployment Name (default: gpt-4)"
                                        x:Name="OpenAIDeploymentNameTextBox"
                                        Text="{Binding OpenAIDeploymentName, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Azure OpenAI Toggle -->
                                <CheckBox Content="Use Azure OpenAI"
                                         IsChecked="{Binding UseAzureOpenAI, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,12"/>

                                <!-- Azure Endpoint (conditional) -->
                                <TextBox materialDesign:HintAssist.Hint="Azure OpenAI Endpoint"
                                        x:Name="AzureOpenAIEndpointTextBox"
                                        Text="{Binding AzureOpenAIEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding UseAzureOpenAI, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Test Connection Button -->
                            <Button Grid.Column="1"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Content="Test Connection"
                                   Click="TestOpenAIConnection_Click"
                                   VerticalAlignment="Top"
                                   Margin="16,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Recent Connections -->
                <materialDesign:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Recent Connections" FontSize="16"
                                  FontWeight="Bold" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding RecentConnections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Chip Content="{Binding}"
                                                     Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No recent connections"
                                  FontStyle="Italic"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"
                                  Visibility="{Binding RecentConnections.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Help Section -->
                <materialDesign:Card Padding="16"
                                 Background="{DynamicResource PrimaryHueLightBrush}">
                    <StackPanel>
                        <TextBlock Text="Need Help?" FontSize="16"
                                  FontWeight="Bold" Margin="0,0,0,8"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="1. Get your Google Ads API credentials from the "/>
                            <Hyperlink NavigateUri="https://ads.google.com/aw/apicenter"
                                      RequestNavigate="HelpLink_RequestNavigate">
                                        Google Ads API Center
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="2. Get your OpenAI API key from the "/>
                            <Hyperlink NavigateUri="https://platform.openai.com/"
                                      RequestNavigate="HelpLink_RequestNavigate">
                                        OpenAI Platform
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap">
                            <Run Text="For detailed setup instructions, visit our "/>
                            <Hyperlink NavigateUri="https://github.com/UPB-FLL/google-ads-optimizer"
                                      RequestNavigate="HelpLink_RequestNavigate">
                                        GitHub Repository
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Save Button -->
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                       Content="Save All Settings"
                       Click="SaveSettings_Click"
                       HorizontalAlignment="Center"
                       Width="200"
                       Height="48"
                       FontSize="16"
                       Margin="0,16,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="1"
              Background="#CC000000"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                           Width="200" Height="4"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Testing connection..."
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>