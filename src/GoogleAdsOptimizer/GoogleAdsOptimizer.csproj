<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>GoogleAdsOptimizer</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Google Ads Optimizer Team</Authors>
    <Product>Google Ads Optimizer</Product>
    <Description>AI-powered Google Ads optimization tool for Windows</Description>
    <Company>Your Company</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Google Ads API -->
    <PackageReference Include="Google.Ads.GoogleAds" Version="20.1.0" />

    <!-- OpenAI Integration -->
    <PackageReference Include="Azure.AI.OpenAI" Version="1.0.0-beta.17" />

    <!-- JSON Processing -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- UI Components -->
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="2.1.4" />

    <!-- HTTP & Network -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />

    <!-- Security -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>